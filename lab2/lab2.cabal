cabal-version: 3.0

name:           lab2
version:        0.1.0.0
build-type:     Simple

executable lab2
    main-is:          Main.hs
    hs-source-dirs:   app

    other-modules:
        BatcherSort

    build-depends:
        base ^>=4.20.0.0

    ghc-options:
        -Wall
        -threaded
        -rtsopts

    default-language: Haskell2010